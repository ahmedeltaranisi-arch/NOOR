{"slug":"shahwaliullah40","chapters":[{"id":0,"title":"أربعون شاه ولي الله الدهلوي","count":40}],"hadiths":[{"id":1,"cid":0,"text":"لَیْسَ الْخَبَرُ کَالْمُعَایَنَةِ"},{"id":2,"cid":0,"text":"الْحَرْبُ خُدَعَةٌ"},{"id":3,"cid":0,"text":"الْمُسْلِمُ مِرْآةُ الْمُسْلِمِ"},{"id":4,"cid":0,"text":"الْمُسْتَشَارُ مُؤتَمَنٌ"},{"id":5,"cid":0,"text":"الدَّالُّ عَلَی الْخَیْرِ کَفَاعِلِهِ"},{"id":6,"cid":0,"text":"إِسْتَعِیْنُوْا عَلَی الْحَوَائِجِ بِالْکِتْمَانِ"},{"id":7,"cid":0,"text":"إِتَّقُوْا النَّارَ وَلَوْ بِشِقِّ تَمْرَةٍ"},{"id":8,"cid":0,"text":"الدُّنْیَا سِجْنُ الْمُؤمِنِ وَ جَنَّةُ الْکَافِرِ"},{"id":9,"cid":0,"text":"الْحَیَاءُ خَیْرٌ کُلُّهُ"},{"id":10,"cid":0,"text":"عِدَةُ الْمُؤمِنِ کَاَخْذِ الْکَفِّ"},{"id":11,"cid":0,"text":"لَا یَحِلُّ لِمُؤمِنٍ اَنْ یَّجُهْرَ أخَاهُ فَوقَ ثَلَاثَةِ أیَّامٍ"},{"id":12,"cid":0,"text":"لَیْسَ مِنَّا مَنْ غَشَّنَا"},{"id":13,"cid":0,"text":"مَا قَلَّ وَكَفَى خَيْرٌ مِمَّا كَثُرَ وَأَلْهَى"},{"id":14,"cid":0,"text":"الرَّاجِعُ فِيْ هِبَتِهِ کَالرَّاجِعِ فِيْ قَیْئِهِ"},{"id":15,"cid":0,"text":"الْبَلَاءُ مُوَکِّلٌ بِالْمَنْطِقِ"},{"id":16,"cid":0,"text":"النَّاسُ کَأسْنَانِ الْمُشْطِ"},{"id":17,"cid":0,"text":"الْغِنَى غِنَى النَّفْسِ"},{"id":18,"cid":0,"text":"الْسَّعِیْدُ مَنْ وُّعِظَ بِغَیْرِهِ"},{"id":19,"cid":0,"text":"وَ إِنَّ مِنَ الشِّعْرِ لَحِکْمَةً وَاِنَّ مِنَ الْبَیَانِ لَسِحْرًا"},{"id":20,"cid":0,"text":"عَفْوُ الْمُلُوْكِ إِبْقَاءٌ لِلْمُلْكِ"},{"id":21,"cid":0,"text":"اَلْمَرْءُ مَعَ مَنْ أَحَبَّ"},{"id":22,"cid":0,"text":"مَا هَلَكَ إمْرُؤٌ عَرَفَ قَدْرَهُ"},{"id":23,"cid":0,"text":"اَلْوَلَدُ لِلْفِرَاشِ وَ لِلْعَاهِرِ الْحَجَرُ"},{"id":24,"cid":0,"text":"الْیَدُ الْعُلْیَا خَیْرٌ مِّنَ الْیَدِ السُّفْلَی"},{"id":25,"cid":0,"text":"لَا شَکَرَ اللهَ مَنْ لَّا یَشْکُرُ النَّاسَ"},{"id":26,"cid":0,"text":"حُبُّكَ الشَّيْءَ یُعْمِيْ وَ یُصِمُّ"},{"id":27,"cid":0,"text":"جُبِلَتِ الْقُلُوبُ عَلی حُبَّ مَنْ اَحْسَنَ اِلَیْهَا وَ بُغْضِ مَنْ اَسَاءَ اِلَیْهَا"},{"id":28,"cid":0,"text":"الْتَّائِبُ مِنَ الذَّنْبِ کَمَنْ لَا ذَنْبَ لَهُ"},{"id":29,"cid":0,"text":"الشَّاهِدُ یَرَی مَا لَا یَرَاهُ الْغَائِبُ"},{"id":30,"cid":0,"text":"اِذا جَاءَکُمْ کَرِیْمُ قَوْمٍ فَاَکْرِمُوهُ"},{"id":31,"cid":0,"text":"الْیَمِینُ الْفَاجِرَةُ تَدَعُ الدِّیَارَ الْبَلَاقِعَ"},{"id":32,"cid":0,"text":"مَنْ قُتِلَ دُونَ مَالِهِ فَهُوَ شَهِیْدٌ"},{"id":33,"cid":0,"text":"الْاَعْمَالُ بِالنِّیَّةِ"},{"id":34,"cid":0,"text":"سَیِّدُ الْقَوْمِ خَادِمُهُمْ"},{"id":35,"cid":0,"text":"خَیْرُ الْأُمُوْرِ أَوْسَطُهَا"},{"id":36,"cid":0,"text":"اَللَّهُمَّ بَارِكْ فِیْ أُمَّتِیْ فِی بُکُوْرِهَا یَوْمَ الْخَمِیْسِ"},{"id":37,"cid":0,"text":"کَادَ الْفَقْرُ أَنْ یَکُوْنَ کُفْرًا"},{"id":38,"cid":0,"text":"الْسَّفَرُ قِطْعَةٌ مِّنَ الْعَذَابِ"},{"id":39,"cid":0,"text":"خَیْرُ زَّادِ الْتَّقْوَی"},{"id":40,"cid":0,"text":"الْمَجَالِسُ بِالْاَمَانَةِ"}]}