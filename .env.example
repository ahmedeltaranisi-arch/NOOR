# ==============================================================================
# نور | NOOR - إعدادات متغيرات البيئة (Environment Variables)
# ==============================================================================
# ملاحظة: يعمل مشروع "نور | NOOR" بالكامل دون الحاجة إلى أي مفاتيح API سرية خارجية.
# جميع حسابات مواقيت الصلاة والقبلة تتم فلكيًا عبر مكتبة Adhan الموثوقة،
# ونصوص القرآن الكريم (الرسم العثماني - 114 سورة / 6236 آية) والأذكار مضمنة محليًا.

# الرابط الأساسي للموقع (يُستخدم في توليد Sitemap و Robots و OpenGraph Metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# المحافظة والمدينة الافتراضية عند أول زيارة (اختياري - الافتراضي: القاهرة)
NEXT_PUBLIC_DEFAULT_GOVERNORATE_ID=cairo
NEXT_PUBLIC_DEFAULT_CITY_ID=cairo-city

# خادم التلاوات الصوتية للقرآن الكريم (اختياري - يستخدم شبكة EveryAyah / Islamic Network الموثوقة افتراضيًا)
NEXT_PUBLIC_QURAN_AUDIO_CDN=https://everyayah.com/data
